# Copy this file to .env for local dev. .env is gitignored — this is
# where secrets go (see docs/skills/go-backend/SKILL.md "Configuration"),
# unlike config.yaml, which never holds them. Values here are overridden
# by real environment variables of the same name, and themselves override
# whatever config.yaml sets.

DATABASE_URL=postgres://user:password@localhost:5432/vincentmegia?sslmode=disable

# Optional: a second connection string for a least-privilege, SELECT-only
# Postgres role (e.g. Supabase's "site_reader" — see docs/features/resume.md's
# Security Considerations). Every repository's read methods use this
# connection when set; every write method and migrations always use
# DATABASE_URL above regardless. Leave unset for local dev — it falls back
# to DATABASE_URL, so a single role is enough to run the app.
# DATABASE_READONLY_URL=

# Bearer token for the internal landing-content API that home-admin (HQ)
# calls — see docs/features/landing-content-api.md. Optional: leave it
# unset and the API routes are not registered at all, which is the right
# posture for local dev. When set it must be at least 32 characters;
# generate it with `openssl rand -hex 32`, never by hand.
# LANDING_API_TOKEN=

# Everything below is optional — see config.example.yaml for the
# non-secret equivalents; either place works, real env vars win over both.
# PORT=8080
# LOG_LEVEL=INFO
# DB_MAX_OPEN_CONNS=10

# Trust X-Forwarded-For's last entry for the in-process rate limiters,
# instead of only r.RemoteAddr. See config.example.yaml's
# trust_proxy_headers key for the full explanation — the short version:
# leave this unset/false everywhere except this app's actual Render
# deployment, which is the one place a trusted reverse proxy sits in
# front of it.
# TRUST_PROXY_HEADERS=false

# Bus Stop Finder (docs/features/bus-stop-finder.md). All optional.
# LTA DataMall key — sent only server-side as the AccountKey header. Unset
# disables the nightly sync and live arrivals (the page still renders).
# LTA_ACCOUNT_KEY=
# Defaults to the real service. For local dev against the fake, run
# `make fakelta` and set this to http://127.0.0.1:8099 (only https or
# plain-http localhost are accepted).
# LTA_BASE_URL=https://datamall2.mytransport.sg
# Browser-side Maps JavaScript API key. Restrict it by HTTP referrer and to
# the Maps JavaScript API in Google Cloud Console. Unset = list-only page.
# GOOGLE_MAPS_API_KEY=
# OneMap origin for postal-code search (no key needed). Defaults to the
# real service; `make run-e2e` points it at the fake in cmd/fakelta.
# ONEMAP_BASE_URL=https://www.onemap.gov.sg
