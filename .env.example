# Copy this file to .env for local dev. .env is gitignored — this is
# where secrets go (see docs/skills/go-backend/SKILL.md "Configuration"),
# unlike config.yaml, which never holds them. Values here are overridden
# by real environment variables of the same name, and themselves override
# whatever config.yaml sets.

DATABASE_URL=postgres://user:password@localhost:5432/vincentmegia?sslmode=disable

# Bearer token for the internal landing-content API that home-admin (HQ)
# calls — see docs/features/landing-content-api.md. Optional: leave it
# unset and the API routes are not registered at all, which is the right
# posture for local dev. When set it must be at least 32 characters;
# generate it with `openssl rand -hex 32`, never by hand.
# LANDING_API_TOKEN=

# Everything below is optional — see config.example.yaml for the
# non-secret equivalents; either place works, real env vars win over both.
# PORT=8080
# LOG_LEVEL=INFO
# DB_MAX_OPEN_CONNS=10

# Trust X-Forwarded-For's last entry for the in-process rate limiters,
# instead of only r.RemoteAddr. See config.example.yaml's
# trust_proxy_headers key for the full explanation — the short version:
# leave this unset/false everywhere except this app's actual Render
# deployment, which is the one place a trusted reverse proxy sits in
# front of it.
# TRUST_PROXY_HEADERS=false
